     result = engine.evaluate(pa, of, blackout_active=False)
+    assert result.action == TradeSignal.NEUTRAL
+    assert any("INSUFFICIENT" in r for r in result.reasons)
+
+def test_confluence_low_confidence_signal_not_counted():
+    """A directional signal below min_confidence should not count as a confirmation."""
+    engine = ConfluenceEngine(min_signals_required=2, min_confidence=0.6)
+    pa = SignalOutput("price_action", TradeSignal.BUY, 0.8)
+    of = SignalOutput("order_flow", TradeSignal.BUY, 0.3)  # below threshold
+
+    result = engine.evaluate(pa, of, blackout_active=False)
+    assert result.action == TradeSignal.NEUTRAL

+def test_confluence_single_signal_is_no_longer_sufficient():
+    """
+    Regression test: news-gate-passing must NOT count as a confirming signal.
+    A lone price-action signal with order flow neutral should NOT fire a trade
+    when min_signals_required=2, since only 1 of 2 modules actually confirmed.
+    """
     engine = ConfluenceEngine(min_signals_required=2, min_confidence=0.5)

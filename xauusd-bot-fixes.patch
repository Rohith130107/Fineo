+    def get_market_book(self, symbol: str) -> Optional[List[Dict[str, Any]]]:
+        """
+        Attempts to subscribe to and read the real Level 2 order book (DOM) for symbol.
+        Returns None if the broker/symbol doesn't expose market depth (common on many
+        retail XAUUSD feeds) — callers must treat None as "fall back to tick proxy",
+        not as an error.
+        """
+        if not mt5.market_book_add(symbol):
+            return None
+        try:
+            book = mt5.market_book_get(symbol)
+            if book is None:
+                return None
+            return [
+                {"type": entry.type, "price": entry.price, "volume": entry.volume}
+                for entry in book
+            ]
+        finally:
+            mt5.market_book_release(symbol)
+
